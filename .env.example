VIGIL_DB_PATH=/data/vigil.db
VIGIL_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Optional: improves identity-discovery search quality. Without it VIGIL falls back to DuckDuckGo HTML.
BRAVE_SEARCH_API_KEY=

# Optional: raises GitHub public API limits for historical README discovery.
GITHUB_TOKEN=

# Optional reverse-image provider. Same/modified image matching only; no face recognition.
TINEYE_API_KEY=
TINEYE_API_URL=https://api.tineye.com/rest/

# Optional local Content Credentials parser. If c2patool is installed in the API container/host,
# VIGIL parses C2PA manifests; otherwise it records marker presence only.
VIGIL_ENABLE_C2PA_TOOL=1
